# Dependencies
node_modules/
**/node_modules/

# Environment and local config
.env
.env.*
.env.testnet
.env.testnet.local
!.env.example
!.env.*.example
.envrc
.npmrc
*.local

# Secrets, keys, keystores, and node identity material
*.pem
*.key
*.secret
*.seed
*.mnemonic
*.password
*.p12
*.pfx
*.kdbx
jwtsecret
**/jwtsecret
**/keystore/
**/nodekey
**/pq-service-keys.json
**/private/
**/.env.local
**/.env.*.local

# CoreGeth's accounts/keystore package is source code. Keep runtime keystores
# ignored everywhere else, but track the vendored client package.
!clients/qubitor-node/coregeth/accounts/keystore/
!clients/qubitor-node/coregeth/accounts/keystore/**

# Chain/node runtime state
data/
logs/
artifacts/
*.log
*.pid
*.lock
LOCK
transactions.rlp

# Build outputs and caches
dist/
out/
build/
coverage/
*.tsbuildinfo
.turbo/
.next/
**/.next/
**/.turbo/
**/dist/
**/out/
**/cache/
**/broadcast/
contracts/cache/
contracts/out/
contracts/broadcast/

# CoreGeth's build directory contains source tooling such as build/ci.go.
# Generated binaries and caches stay ignored.
!clients/qubitor-node/coregeth/build/
!clients/qubitor-node/coregeth/build/**
!clients/qubitor-node/coregeth/internal/build/
!clients/qubitor-node/coregeth/internal/build/**
clients/qubitor-node/coregeth/build/bin/
clients/qubitor-node/coregeth/build/_bin/
clients/qubitor-node/coregeth/build/_workspace/
clients/qubitor-node/coregeth/build/cache/
clients/qubitor-node/coregeth/build/static/

# Go outputs
*.test
*.prof
*.cover
coverage.out

# Python/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Package-manager and tool caches
.pnpm-store/
.npm/
.yarn/
*.tgz
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local IDE/agent state
.claude/
.vscode/
.idea/
*.swp
*.swo
.embedded-git-backups/

# OS noise
.DS_Store
Thumbs.db

# Avoid accidentally committing an embedded git repo as a submodule.
# Vendor this intentionally later if we want sphincsminus in-tree.
research/sphincsminus/

# Local CoreGeth scratch output.
clients/qubitor-node/coregeth/git.diff
