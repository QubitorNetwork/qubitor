# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=replace-with-discord-bot-token

# Discord server ID, not the application/client ID.
DISCORD_GUILD_ID=replace-with-discord-server-id

# Public invite shown in server setup messages.
DISCORD_SERVER_INVITE_URL=https://discord.gg/replace-with-invite

# Optional: set to 1 to print planned writes without changing Discord.
DISCORD_DRY_RUN=0

# --- Presale contribution notifier (scripts/discord/presale-notifier.mjs) ---
# Base RPC for reading the presale contract logs (public default works; a
# dedicated RPC is more reliable). HTTPS endpoint (not wss).
BASE_RPC_URL=https://mainnet.base.org
# QubitorPresale contract on Base.
PRESALE_ADDRESS=0x21117BAc2FE181f8bEa2378B3B4A0ab903bEA688
# Optional: pin the target channel id (otherwise it finds/creates #presale).
DISCORD_PRESALE_CHANNEL_ID=
# Optional: poll interval in ms (default 12000).
PRESALE_POLL_MS=12000
